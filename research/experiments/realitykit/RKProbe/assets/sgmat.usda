#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "RKPMat"
    {
        color3f inputs:Tint = (0.1, 0.6, 0.9) (
            customData = { dictionary realitykit = { float2 positionInSubgraph = (0, 0) } }
        )
        token outputs:mtlx:surface.connect = </Root/RKPMat/PreviewSurface.outputs:out>
        token outputs:surface.connect = </Root/RKPMat/UsdPreview.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor.connect = </Root/RKPMat.inputs:Tint>
            float inputs:roughness = 0.3
            float inputs:metallic = 0
            token outputs:out
        }

        def Shader "UsdPreview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.1, 0.6, 0.9)
            token outputs:surface
        }
    }
}
