{
 "name": "b5-obs-popovers",
 "title": "B5-OBS 2/6: scheme and destination popovers, New Scheme sheet, Quick Help top and bottom, Jump to Line, Quick Actions, Open Quickly, Library, Quick New Project, active look, Product ▸ Destination.",
 "targets": [
  "xcode"
 ],
 "compare_order": [
  "xcode"
 ],
 "focus": "foreground",
 "launch_settle": 3.0,
 "record": {
  "fps": 120,
  "codec": "hevc",
  "pre": 0.5,
  "post": 1.0
 },
 "project": {
  "generator": "make-parity-project.py",
  "path": "Parity/Parity.xcodeproj"
 },
 "window": {
  "size": [
   1400,
   880
  ],
  "display": "builtin",
  "title": "{project}",
  "timeout": 90,
  "offset": [
   1020,
   300
  ]
 },
