  {
   "id": "quick-open",
   "note": "File ▸ New ▸ Project… by its shortcut (cmd+shift+N) from the Welcome window: what opens (Xcode 27.1: a quick New Project panel). AX tree.",
   "do": [
    {
     "key": "cmd+shift+n"
    },
    {
     "wait": 2.0
    },
    {
     "tree": "quick",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.0
   },
   "still": "both",
   "per_target": {
    "ycode": {
     "do": [
      {
       "key": "cmd+shift+n"
      },
      {
       "wait": 2.0
      },
      {
       "tree": "quick",
       "depth": 40
      },
      {
       "click": {
        "label": "New Project",
        "role": "AXMenuButton",
        "scope": "app"
       }
      },
      {
       "wait": 1.0
      }
     ],
     "note": "File ▸ New ▸ Project… by its shortcut (cmd+shift+N) from the Welcome window: what opens (Xcode 27.1: a quick New Project panel). AX tree. Ycode: cmd+shift+N first (nothing happens), then the Welcome window's New Project menu."
    }
   }
  },
