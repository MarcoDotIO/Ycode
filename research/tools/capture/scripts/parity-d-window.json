    {
     "tree": "rest",
     "depth": 40
    }
   ],
   "record": {
    "video": false,
    "mode": "app",
    "margin": 600
   },
   "still": "after"
  },
  {
   "id": "resize-700",
   "note": "Set the window to 700 × 880 through Accessibility (Ycode's minimum width).",
   "do": [
    {
     "resize": [
      700,
      880
     ]
    },
    {
     "wait": 0.8
    },
    {
     "tree": "w700",
     "depth": 40
    }
