   "do": [],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.2
   },
   "still": "both",
   "per_target": {
    "xcode": {
     "do": [
      {
       "drag": {
        "from": {
         "label~": "Push Button",
         "scope": "app",
         "visible": true
        },
        "to": [
         700,
         600
        ]
       },
       "duration": 1.2
      },
      {
       "wait": 1.5
      },
      {
       "tree": "dropped",
       "depth": 40
      }
     ]
    },
    "ycode": {
     "do": [
      {
       "drag": {
        "from": {
         "label": "Button",
         "scope": "app",
         "visible": true
        },
        "to": [
         1100,
         500
        ]
       },
       "duration": 1.2
      },
      {
       "drag": {
        "from": {
         "label~": "Button",
         "scope": "app",
         "visible": true
        },
        "to": [
         1100,
         500
        ]
       },
       "duration": 1.2,
       "fallback": true
      },
      {
       "wait": 1.5
      },
      {
       "tree": "dropped",
       "depth": 40
      }
     ]
    }
   }
  },
  {
   "id": "ib-library-close",
   "note": "Escape (the Library, if it stayed), then its window's close button if it is a window.",
   "do": [
    {
     "key": "escape"
    },
    {
     "wait": 0.6
    },
    {
     "press": {
      "role": "AXButton",
      "subrole": "AXCloseButton"
     },
     "window": "Library"
    },
    {
     "wait": 0.6
    }
   ],
   "record": false,
   "still": "none"
  },
