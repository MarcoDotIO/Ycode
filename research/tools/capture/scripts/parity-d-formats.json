      "role": "AXRow",
      "text": "Main|Main.storyboard"
     }
    },
    {
     "wait": 4.0
    }
   ],
   "record": false,
   "still": "none"
  },
  {
   "id": "ib-zoom-fit",
   "note": "Editor ▸ Zoom ▸ Zoom to Fit.",
   "do": [
    {
     "menu": "Editor > Zoom > Zoom to Fit"
    },
    {
     "wait": 1.2
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.0
   },
   "still": "both"
  },
  {
   "id": "ib-library",
   "note": "shift+cmd+L, type 'button'. AX tree.",
   "do": [
    {
     "key": "cmd+shift+l"
    },
    {
     "wait": 1.5
    },
    {
     "text": "button"
    },
    {
     "wait": 1.5
    },
    {
     "tree": "library",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.0
   },
   "still": "both"
  },
  {
   "id": "ib-drag-button",
