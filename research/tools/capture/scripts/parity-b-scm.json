  {
   "id": "merge-cleanup",
   "note": "Not judged: the copy's merge state is reset with git (merge --abort, reset --hard) so the next steps start clean.",
   "do": [
    {
     "run": [
      "sh",
      "-c",
      "git merge --abort 2>/dev/null; git reset -q --hard; git status --short"
