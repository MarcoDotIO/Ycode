    {
     "tree": "rest",
     "depth": 40
    }
   ],
   "record": {
    "video": false,
    "mode": "app",
    "margin": 600
   },
   "still": "after"
  },
  {
   "id": "scm-navigator",
   "note": "cmd+2: the Source Control navigator (its Changes view, empty). AX tree.",
