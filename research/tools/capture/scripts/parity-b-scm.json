  {
   "id": "local-edit",
   "note": "Greeting.swift changed on disk (one line edited, two appended); open it from the project navigator: change bars in the gutter, the M badge.",
   "do": [
    {
     "run": [
      "sh",
      "-c",
      "sed -i '' 's/Good morning/Good evening/' Merger/Greeting.swift && printf '\\n// A local change for the source control captures.\\nlet localChange = 1\\n' >> Merger/Greeting.swift"
     ]
    },
    {
     "wait": 2.0
    },
    {
     "key": "cmd+1"
    },
    {
     "wait": 0.6
    },
    {
     "click": {
      "role": "AXRow",
      "text": "Greeting|Greeting.swift"
     }
    },
    {
     "wait": 2.5
    },
    {
     "tree": "changed",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.0
   },
   "still": "both"
  },
