{
 "name": "parity-b-scm",
 "title": "Part B 6: source control with Merger: the Source Control navigator (Changes, Repositories, branches, tags, history, a commit), the merge confirmation and sheet (cancelled), a new branch (deleted again), change bars, Code Review, the History inspector, the commit sheet (cancelled), the Source Control context sub-menu.",
 "targets": [
  "xcode",
  "ycode"
 ],
 "compare_order": [
  "xcode",
  "ycode"
 ],
 "focus": "foreground",
 "launch_settle": 3.0,
 "record": {
  "fps": 120,
  "codec": "hevc",
  "pre": 0.5,
  "post": 1.2
 },
 "steps": [
  {
   "id": "rest",
   "note": "Merger open (clean main). AX tree.",
