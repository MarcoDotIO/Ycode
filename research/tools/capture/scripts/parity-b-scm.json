    {
     "key": "cmd+2"
    },
    {
     "wait": 1.5
    },
    {
     "tree": "scm",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.0
   },
   "still": "both"
  },
