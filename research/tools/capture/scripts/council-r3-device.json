  ],
  "window": {
    "size": [
      1100,
      800
    ],
    "display": "builtin",
    "title": "ycode-test-council-iphone",
    "wait_title": null,
    "first_window_wait": 6.0,
    "timeout": 90
  },
  "focus": "foreground",
  "launch_settle": 1.0,
  "setup_settle": 2.0,
  "record": {
