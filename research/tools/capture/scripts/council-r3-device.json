      {
        "menu": "View > Hide Sidebar"
      },
      {
        "wait": 1.0
      }
    ],
    "ycode": [
      {
        "menu": "Ycode > Open Developer Tool > Device Hub"
      },
      {
        "wait": 3.0
      },
      {
        "select": {
          "role": "AXRow",
          "text~": "ycode-test-council",
          "scope": "app"
        }
      },
      {
        "wait": 1.5
      },
      {
        "press": {
          "role": "AXButton",
          "description": "Sidebar",
          "scope": "app"
        }
      },
      {
        "wait": 1.0
      }
    ]
  },
  "steps": [
    {
      "id": "device-home-at-rest",
      "note": "The device window with ycode-test-council-iphone (iPhone Duo, iOS 27.1) selected, sidebar hidden (the sidebar lists every device on this Mac). Reference: the running device's Home screen. Ycode: what it shows for a simctl device it does not run (its simulators run on a Linux host).",
      "record": false,
