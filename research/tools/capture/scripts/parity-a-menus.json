{
 "name": "parity-a-menus",
 "title": "Part A 3: every top-level menu opened by mouse, every sub-menu, diagonal moves, menu-bar sliding, keyboard navigation, the Help search field.",
 "targets": [
  "xcode",
  "ycode"
 ],
 "compare_order": [
  "xcode",
  "ycode"
 ],
 "focus": "foreground",
 "launch_settle": 3.0,
 "record": {
  "fps": 120,
  "codec": "hevc",
  "pre": 0.5,
  "post": 1.2
 },
 "steps": [
  {
   "id": "rest",
   "note": "The workspace window at rest, Long.swift not open. The whole menu bar (titles, key equivalents, enabled state, checkmarks) through Accessibility.",
   "do": [
    {
     "menubar": "workspace"
    }
   ],
   "record": false,
   "still": "after"
  },
  {
   "id": "app-open",
   "note": "Open the {app} menu by clicking its menu bar title (animation); the after still is the whole menu.",
   "do": [
    {
     "click": {
      "role": "AXMenuBarItem",
      "title": "{app}",
      "scope": "app"
     }
    },
    {
     "wait": 0.5
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.8
   },
   "still": "both"
  },
  {
   "id": "app-behaviors",
   "note": "Hover {app} ▸ Behaviors: its sub-menu cascades open (or, if it is a plain item, its highlight).",
   "do": [
    {
     "hover": {
      "role": "AXMenuItem",
      "title": "Behaviors",
      "scope": "app",
      "visible": true
     }
    },
    {
     "wait": 0.4
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.9
   },
   "still": "both"
  },
  {
   "id": "app-open-developer-tool",
   "note": "Hover {app} ▸ Open Developer Tool: its sub-menu cascades open (or, if it is a plain item, its highlight).",
   "do": [
    {
     "hover": {
      "role": "AXMenuItem",
      "title": "Open Developer Tool",
      "scope": "app",
      "visible": true
     }
    },
    {
     "wait": 0.4
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.9
   },
   "still": "both"
  },
  {
   "id": "app-services",
   "note": "Hover {app} ▸ Services: its sub-menu cascades open (or, if it is a plain item, its highlight).",
   "do": [
    {
     "hover": {
      "role": "AXMenuItem",
      "title": "Services",
      "scope": "app",
      "visible": true
     }
    },
    {
     "wait": 0.4
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.9
   },
   "still": "both"
  },
  {
   "id": "app-diagonal",
   "note": "Diagonal pointer move from {app} ▸ Behaviors into its sub-menu (right 220 pt, down 90 pt over 0.35 s) then onto the sibling item: does the sub-menu stay open, and how do siblings switch?",
   "do": [
    {
     "hover": {
      "role": "AXMenuItem",
      "title": "Behaviors",
      "scope": "app",
      "visible": true
     }
    },
    {
     "wait": 0.7
    },
    {
     "glide": {
      "from": {
       "role": "AXMenuItem",
       "title": "Behaviors",
       "scope": "app",
       "visible": true
      },
      "to": {
       "role": "AXMenuItem",
       "title": "Behaviors",
       "scope": "app",
       "visible": true
      },
      "to_dx": 220,
      "to_dy": 90
     },
     "duration": 0.35
    },
    {
     "wait": 0.6
    },
    {
     "hover": {
      "role": "AXMenuItem",
      "title": "Services",
      "scope": "app",
      "visible": true
     }
    },
    {
     "wait": 0.7
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.8
   },
   "still": "both"
  },
  {
   "id": "app-walk",
   "note": "Every enabled sub-menu of {app}, hovered one by one: a still of each cascade (no video).",
   "do": [
    {
     "submenus": "sub",
     "wait": 0.8
    }
   ],
   "record": false,
   "still": "none"
  },
  {
   "id": "app-close",
   "note": "Escape closes the {app} menu.",
