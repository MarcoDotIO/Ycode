{
 "name": "b5-obs-qh",
 "title": "B5-OBS 3b: Quick Help popovers for symbols in the upper part of the editor.",
 "targets": [
  "xcode"
 ],
 "compare_order": [
  "xcode"
 ],
 "focus": "foreground",
 "launch_settle": 3.0,
 "record": {
  "fps": 120,
  "codec": "hevc",
  "pre": 0.5,
  "post": 1.0
 },
 "project": {
  "generator": "make-parity-project.py",
  "path": "Parity/Parity.xcodeproj"
 },
 "window": {
  "size": [
   1400,
   880
  ],
  "display": "builtin",
  "title": "{project}",
  "timeout": 90,
  "offset": [
   1020,
   300
  ]
 },
 "steps": [
  {
   "id": "d-qh-near-top",
   "note": "option+click 'Foundation' in 'import Foundation' (line 3, the editor's top): Quick Help. AX tree.",
   "do": [
    {
     "textclick": {
      "needle": "import Foundation",
      "occurrence": 1,
      "offset": 9
     },
     "modifiers": "alt"
    },
    {
     "wait": 2.5
    },
    {
     "tree": "qh",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.8
   },
   "still": "both"
  },
  {
   "id": "d-qh-near-top-close",
   "note": "Escape.",
   "do": [
    {
     "key": "escape"
    },
    {
     "wait": 0.8
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.5
   },
   "still": "both"
  },
  {
   "id": "d-qh-mid",
   "note": "option+click 'Mode0' (line 7, upper third): Quick Help.",
   "do": [
    {
     "textclick": {
      "needle": "enum Mode0",
      "occurrence": 1,
      "offset": 6
     },
     "modifiers": "alt"
    },
    {
     "wait": 2.5
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.8
   },
   "still": "both"
  },
  {
   "id": "d-qh-mid-close",
   "note": "Escape.",
