   "still": "both"
  },
  {
   "id": "l-appearance-light",
   "note": "Settings ▸ Appearance: Xcode's own Appearance set to Light; Settings closed.",
   "do": [
    {
     "key": "cmd+,"
    },
    {
     "wait": 2.0
    },
    {
     "select": {
      "role": "AXRow",
      "text": "Appearance",
      "scope": "app"
     }
    },
    {
     "wait": 1.2
    },
    {
     "press": {
      "role": "AXButton",
      "description": "AppearanceLight",
      "scope": "app"
     }
    },
    {
     "wait": 1.5
    },
    {
     "tree": "appearance",
     "depth": 40
    },
    {
     "key": "cmd+w"
    },
    {
     "wait": 1.0
    }
   ],
