{
 "name": "parity-c-help",
 "title": "Part C 5: the Help menu's search field and results, the About window, the Developer Documentation window with a search, and the Organizer (each sidebar row).",
 "targets": [
  "xcode",
  "ycode"
 ],
 "compare_order": [
  "xcode",
  "ycode"
 ],
 "focus": "foreground",
 "launch_settle": 3.0,
 "record": {
  "fps": 120,
  "codec": "hevc",
  "pre": 0.5,
  "post": 1.2
 },
 "steps": [
  {
   "id": "open-shapes",
   "note": "Open Shapes.swift.",
   "do": [
    {
     "click": {
      "role": "AXRow",
      "text": "Shapes|Shapes.swift"
     }
    },
    {
     "wait": 2.5
    }
   ],
   "record": false,
   "still": "none"
  },
  {
   "id": "help-menu",
   "note": "Click Help in the menu bar: the menu with its search field (animation). AX tree.",
   "do": [
    {
     "click": {
      "role": "AXMenuBarItem",
      "title": "Help",
      "scope": "app"
     }
    },
    {
     "wait": 1.2
    },
    {
     "tree": "help",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.6
   },
   "still": "both"
  },
  {
   "id": "help-search",
   "note": "Type 'zoom' into the Help search field: the results (menu items and help topics). AX tree.",
   "do": [
    {
     "text": "zoom"
    },
    {
     "wait": 2.5
    },
    {
     "tree": "results",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.8
   },
   "still": "both"
  },
  {
   "id": "help-search-arrow",
   "note": "Down arrow onto the first menu-item result: the pointer arrow shows the item in its menu (animation).",
   "do": [
    {
     "key": "down"
    },
    {
     "wait": 2.0
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.8
   },
   "still": "both"
  },
  {
   "id": "help-close",
   "note": "Escape.",
   "do": [
    {
     "key": "escape escape escape"
    },
    {
     "wait": 0.5
    }
   ],
   "record": false,
   "still": "none"
  },
  {
   "id": "help-search-empty",
   "note": "Help, then 'qqqzz' (no results).",
   "do": [
    {
     "click": {
      "role": "AXMenuBarItem",
      "title": "Help",
      "scope": "app"
     }
    },
    {
     "wait": 1.0
    },
    {
     "text": "qqqzz"
    },
    {
     "wait": 2.0
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.6
   },
   "still": "both"
  },
  {
   "id": "help-close-2",
   "note": "Escape.",
   "do": [
    {
     "key": "escape escape escape"
    },
    {
     "wait": 0.5
    }
   ],
   "record": false,
   "still": "none"
  },
  {
   "id": "about",
   "note": "{app} ▸ About {app}: the About window (animation). AX tree.",
   "do": [
    {
     "menu": "{app} > About {app}"
    },
    {
     "wait": 2.0
    },
    {
     "tree": "about",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.8
   },
   "still": "both"
  },
  {
   "id": "about-close",
   "note": "cmd+W.",
