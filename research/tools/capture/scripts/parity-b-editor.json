{
 "name": "parity-b-editor",
 "title": "Part B 1a: the source editor with Showcase.swift: syntax colouring, scrolling, minimap, code folding, jump bar menus, Related Items, find and replace, Go to Line, multiple insertion points, comment toggling, indentation, Authors.",
 "targets": [
  "xcode",
  "ycode"
 ],
 "compare_order": [
  "xcode",
  "ycode"
 ],
 "focus": "foreground",
 "launch_settle": 3.0,
 "record": {
  "fps": 120,
  "codec": "hevc",
  "pre": 0.5,
  "post": 1.2
 },
 "steps": [
  {
   "id": "rest",
   "note": "Showcase.swift open (selected in the navigator), at rest: syntax colouring of the first screen. AX tree and the whole menu bar.",
   "do": [
    {
     "tree": "rest",
     "depth": 40
    },
    {
     "menubar": "showcase"
    }
   ],
   "record": {
    "video": false,
    "mode": "app",
    "margin": 600
   },
   "still": "after"
  },
  {
   "id": "focus",
   "note": "Click into the editor at 'import Foundation' (caret, current-line highlight). The menu bar again (enabled states with the editor focused).",
   "do": [
    {
     "textclick": {
      "needle": "import Foundation",
      "occurrence": 1,
      "offset": 3
     }
    },
    {
     "wait": 0.6
    },
    {
     "menubar": "editor-focused"
    },
    {
     "tree": "focused",
     "depth": 40
    }
   ],
   "record": {
    "video": false,
    "mode": "app",
    "margin": 600
   },
   "still": "after"
  },
  {
   "id": "scroll-down",
   "note": "Wheel scroll 1200 pt down over 1 s (phase-less wheel events, exact deltas).",
   "do": [
    {
     "scroll": {
      "at": [
       700,
       500
      ]
     },
     "dy": -1200,
     "steps": 120,
     "interval": 0.008333
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.0
   },
   "still": "both"
  },
  {
   "id": "flick-down",
   "note": "A fast flick down (8 gesture events of 40 pt, then momentum).",
   "do": [
    {
     "scroll": {
      "at": [
       700,
       500
      ]
     },
     "dy": -320,
     "steps": 8,
     "interval": 0.008333,
     "momentum": true,
     "momentum_tau": 0.33,
     "phases": true
