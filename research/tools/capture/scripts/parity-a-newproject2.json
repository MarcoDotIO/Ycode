  {
   "id": "product-name",
   "note": "Click the Product Name field and type 'ParityApp' (the bundle identifier follows).",
   "do": [
    {
     "click": {
      "identifier": "productName",
      "scope": "app"
     }
    },
    {
     "key": "cmd+a"
    },
    {
     "text": "ParityApp"
    },
    {
     "wait": 0.6
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.8
   },
   "still": "both"
  },
  {
   "id": "popup-interface",
