{
 "name": "parity-a-newproject2",
 "title": "Part A 2b: the New Project options page: key-view order, the product name, its pop-up menus, the save sheet (cancelled), cancelling the assistant.",
 "targets": [
  "xcode",
  "ycode"
 ],
 "compare_order": [
  "xcode",
  "ycode"
 ],
 "focus": "foreground",
 "launch_settle": 3.0,
 "record": {
  "fps": 120,
  "codec": "hevc",
  "pre": 0.5,
  "post": 1.2
 },
 "steps": [
  {
   "id": "to-options",
   "note": "Not judged: reach the options page of macOS ▸ App (the first macOS template, selected by default).",
   "do": [
    {
     "key": "cmd+shift+n"
    },
    {
     "wait": 2.0
    },
    {
     "click": {
      "role": "AXRow",
      "text": "Choose Template…",
      "scope": "app"
     }
    },
    {
     "wait": 2.5
    },
    {
     "click": {
      "role": "AXRadioButton",
      "label": "macOS",
      "scope": "app",
      "visible": true
     }
    },
    {
     "click": {
      "label": "macOS",
      "scope": "app",
      "visible": true
     },
     "fallback": true
    },
    {
     "wait": 0.8
    },
    {
     "wait": 0.5
    },
    {
     "press": {
      "role": "AXButton",
      "title": "Next",
      "scope": "app"
     }
    },
    {
     "wait": 1.5
    },
    {
     "tree": "options",
     "depth": 40
    }
   ],
   "record": false,
   "still": "after",
   "per_target": {
    "ycode": {
     "do": [
      {
       "click": {
        "label": "New Project",
        "role": "AXMenuButton",
        "scope": "app"
       }
      },
      {
       "wait": 1.0
      },
      {
       "click": {
        "role": "AXMenuItem",
        "title": "Choose Template…",
        "scope": "app",
        "visible": true
       }
      },
      {
       "wait": 2.0
      },
      {
       "move": [
        56,
        57
       ],
       "window": "Untitled"
      },
      {
       "wait": 1.0
      },
      {
       "click": {
        "role": "AXRadioButton",
        "label": "macOS",
        "scope": "app",
        "visible": true
       }
      },
      {
       "click": {
        "label": "macOS",
        "scope": "app",
        "visible": true
       },
       "fallback": true
      },
      {
       "wait": 0.8
      },
      {
       "wait": 0.5
      },
      {
       "press": {
        "role": "AXButton",
        "title": "Next",
        "scope": "app"
       }
      },
      {
       "wait": 1.5
      },
      {
       "tree": "options",
       "depth": 40
      }
     ]
    }
   }
  },
