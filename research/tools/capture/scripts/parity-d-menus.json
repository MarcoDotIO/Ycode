    {
     "hoveritem": "Font"
    },
    {
     "wait": 1.2
    },
    {
     "tree": "font",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.6
   },
   "still": "both"
  },
  {
   "id": "edit-format-text",
   "note": "Move onto Format ▸ Text.",
   "do": [
    {
     "hoveritem": "Text"
    },
    {
     "wait": 1.2
    },
    {
     "tree": "text",
     "depth": 40
