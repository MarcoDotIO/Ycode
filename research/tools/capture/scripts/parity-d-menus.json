{
 "name": "parity-d-menus",
 "title": "Part D 1: the Edit menu's sub-menus (Format ▸ Font / Text, Convert, …) and the Editor menu with no file, pointed at by their frames.",
 "targets": [
  "xcode",
  "ycode"
 ],
 "compare_order": [
  "xcode",
  "ycode"
 ],
 "focus": "foreground",
 "launch_settle": 3.0,
 "record": {
  "fps": 120,
  "codec": "hevc",
  "pre": 0.5,
  "post": 1.2
 },
 "steps": [
  {
   "id": "rest",
   "note": "GlassScroll open, no file in the editor. Menu bar.",
   "do": [
    {
     "menubar": "rest"
    }
   ],
   "record": {
    "video": false,
    "mode": "app",
    "margin": 600
   },
   "still": "after"
  },
  {
   "id": "edit-open",
   "note": "Click Edit in the menu bar (the first menu opened in this app's life).",
   "do": [
    {
     "click": {
      "role": "AXMenuBarItem",
      "title": "Edit",
      "scope": "app"
     }
    },
    {
     "wait": 1.0
    },
    {
     "tree": "edit",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.6
   },
   "still": "both"
  },
  {
   "id": "edit-format",
   "note": "Point at Edit ▸ Format by its frame (hovering the parent opens the cascade).",
   "do": [
    {
     "hoveritem": "Format"
    },
    {
     "wait": 1.2
    },
    {
     "tree": "format",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 0.6
   },
   "still": "both"
  },
  {
   "id": "edit-format-font",
   "note": "Move right onto Format ▸ Font (its own cascade).",
