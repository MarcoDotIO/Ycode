{
 "name": "parity-c-editors",
 "title": "Part C 2: editors for other file types (asset catalog, property list, entitlements, String Catalog, test plan, Interface Builder, Core Data model, Markdown, JSON, image) and the SwiftUI preview canvas.",
 "targets": [
  "xcode",
  "ycode"
 ],
 "compare_order": [
  "xcode",
  "ycode"
 ],
 "focus": "foreground",
 "launch_settle": 3.0,
 "record": {
  "fps": 120,
  "codec": "hevc",
  "pre": 0.5,
  "post": 1.2
 },
 "steps": [
  {
   "id": "open-assets",
   "note": "Click Assets in the navigator: the asset catalog editor (asset list, empty detail). AX tree.",
   "do": [],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.0
   },
   "still": "both",
   "per_target": {
    "xcode": {
     "do": [
      {
       "click": {
        "role": "AXRow",
        "text": "Assets|Assets.xcassets"
       }
      },
      {
       "wait": 3.0
      },
      {
       "tree": "assets",
       "depth": 40
      }
     ]
    },
    "ycode": {
     "do": [
      {
       "click": {
        "role": "AXRow",
        "text": "Assets|Assets.xcassets"
       }
      },
      {
       "wait": 3.0
      },
      {
       "tree": "assets",
       "depth": 40
      }
     ]
    }
   }
  },
  {
   "id": "asset-swatch",
   "note": "Click the Swatch colour set in the asset list: its detail (Any/Dark swatches).",
   "do": [
    {
     "click": {
      "role": "AXRow",
      "text": "Swatch",
      "scope": "app",
      "visible": true
     }
    },
    {
     "wait": 1.2
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.0
   },
   "still": "both"
  },
  {
   "id": "asset-attributes",
   "note": "View ▸ Inspectors ▸ Attributes (option+cmd+5): the colour set's Attributes inspector. AX tree.",
   "do": [
    {
     "key": "cmd+alt+5"
    },
    {
     "wait": 1.2
    },
    {
     "tree": "attributes",
     "depth": 40
    }
   ],
   "record": {
    "mode": "app",
    "margin": 600,
    "post": 1.0
   },
   "still": "both"
  },
  {
   "id": "asset-plus-menu",
