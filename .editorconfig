# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# A trailing double space is a line break in Markdown.
trim_trailing_whitespace = false

[*.{pbxproj,xcscheme,xcworkspacedata,plist,entitlements,xcconfig}]
# These follow the formats' own conventions, and tests compare them byte for byte.
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[{Makefile,*.mk}]
indent_style = tab

[{ycode/Sources/CVulkan/**,ycode/Sources/CYcodeOpenXR/**,ycode/Sources/CYcodeVideo/nvheaders/**,frameworks/swiftui/Sources/COVSDL/**,frameworks/swiftui/Sources/COVVulkan/**,frameworks/swiftui/Sources/CThorVG/**}]
# Vendored sources stay as their authors wrote them.
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
